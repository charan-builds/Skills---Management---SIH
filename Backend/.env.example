# Backend Environment Configuration
PORT=10000
# These defaults run the bundled local/demo experience. For a production
# datastore deployment, set ENVIRONMENT=production, ENABLE_DEMO_MODE=false,
# a strong SECRET_KEY, and valid Firebase credentials.
ENVIRONMENT=development
ENABLE_DEMO_MODE=true
# SECRET_KEY=generate-a-long-random-secret-before-production

# Exact browser origins permitted to call the API. Add each deployed frontend
# origin here; do not include a trailing slash.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Optional, narrowly scoped regex for owned preview domains.
# CORS_ALLOW_ORIGIN_REGEX=https://your-project-[a-z0-9-]+\.vercel\.app

# Firebase Configuration (used only when ENABLE_DEMO_MODE=false)
# Option 1: Path to service account json file
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase/credentials.json
# Option 2: Full JSON string for cloud deployments (e.g. Render / HuggingFace)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Database URL (Optional - default uses Firestore/Demo store)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
