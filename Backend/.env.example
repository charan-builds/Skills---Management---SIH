# Environment Mode
ENVIRONMENT=production
ENABLE_DEMO_MODE=true

# Server Configuration
PORT=8001
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-app.vercel.app

# Firebase Admin SDK Configuration (Optional in Demo Mode)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service-account.json

# Gemini AI / LLM API Key (Optional in Demo Mode)
GEMINI_API_KEY=
