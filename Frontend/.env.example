# Frontend Environment Configuration

# API Base URL for the backend service (FastAPI)
# In development, set to http://localhost:8001
# In production (e.g. Render/Vercel), set to your deployed backend URL (e.g. https://skilling-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:8001
VITE_API_BASE=http://localhost:8001

# Show bundled demo shortcuts only when the backend also has ENABLE_DEMO_MODE=true.
VITE_ENABLE_DEMO_MODE=true

# Firebase Authentication (Optional Production Identity)
# Populate these with your Firebase project configuration if utilizing live Firebase auth
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
